# Copy to .env.prod and fill in. Never commit .env.prod.

# Database password (the app connects as the user "aary").
POSTGRES_PASSWORD=

# Signs the session cookies. A long random string:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AARY_JWT_SECRET=

# The public address of the site, exactly as people type it, e.g. https://quiz.example
AARY_PUBLIC_ORIGIN=

# How many reverse proxies sit in front of the web app. 1 = your HTTPS proxy, which must put the
# visitor's address in X-Forwarded-For. 0 = nothing in front (everybody then looks like one address
# to the rate limits).
AARY_TRUSTED_PROXY_HOPS=1

# Where the web app is published on this machine. 127.0.0.1 = only a proxy on the same machine.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# dev | production. In production the app refuses to start with an insecure cookie, a placeholder
# or low-variety JWT secret, or no AARY_ALLOWED_ORIGINS.
AARY_ENV=dev

AARY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aary
AARY_REDIS_URL=redis://localhost:6379/0
# Connections this backend may hold to Redis (requests wait when all are busy).
AARY_REDIS_MAX_CONNECTIONS=100

# Long random string, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AARY_JWT_SECRET=change-me-change-me-change-me-change-me
AARY_JWT_TTL_MINUTES=720

# true when the site is served over https (required in production)
AARY_COOKIE_SECURE=false

# Browser origins allowed to open the game WebSockets, comma separated. The Next.js dev server on
# :3000 forwards /api to the backend, so the browser's origin differs from the backend's host.
# In production: the public site, e.g. https://quiz.example
AARY_ALLOWED_ORIGINS=http://localhost:3000

# Always start uvicorn with --no-proxy-headers: its own handling of X-Forwarded-For (on by default
# for requests from localhost) would let a client invent its address and skip every rate limit.
# How many reverse proxies stand in front of the backend. 0 = none: X-Forwarded-For is ignored,
# so nobody can pick their own address for rate limits. 1 = one proxy that appends the client's
# address to X-Forwarded-For.
AARY_TRUSTED_PROXY_HOPS=0

# Questions from teaching material (PDF, Word, PowerPoint, text). Empty: the feature is off.
OPENAI_API_KEY=sk-proj-some-gibberish
AARY_OPENAI_MODEL=gpt-5.4-mini
# Generations per teacher per day.
AARY_AI_DAILY_LIMIT=20

{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "predev": "npm run tokens",
    "dev": "next dev",
    "prebuild": "npm run tokens",
    "build": "next build",
    "start": "next start",
    "check": "npm run check:scoring && npm run check:admin && npm run check:contest-form && npm run check:jury && npm run check:player && npm run check:host && npm run check:quiz-import",
    "check:jury": "node --experimental-strip-types --no-warnings --import ./scripts/alias-register.mjs scripts/check-jury.mts",
    "check:contest-form": "node --experimental-strip-types --no-warnings --import ./scripts/alias-register.mjs scripts/check-contest-form.mts",
    "check:admin": "node --experimental-strip-types --no-warnings --import ./scripts/alias-register.mjs scripts/check-admin.mts",
    "check:scoring": "node --experimental-strip-types --no-warnings --import ./scripts/alias-register.mjs scripts/check-scoring.mts",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "lint": "node scripts/generate-tokens.mjs --check && eslint",
    "check:player": "node --experimental-strip-types --no-warnings --import ./scripts/alias-register.mjs scripts/check-player-flow.mts",
    "check:host": "node --experimental-strip-types --no-warnings --import ./scripts/alias-register.mjs scripts/check-host-flow.mts",
    "check:quiz-import": "node --experimental-strip-types --no-warnings --import ./scripts/alias-register.mjs scripts/check-quiz-import.mts",
    "check:bundle": "node scripts/check-player-bundle.mjs",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "15.5.27",
    "next-intl": "^4.14.9",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "playwright": "1.56.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
